{
  "name": "gettargetrole",
  "private": true,
  "description": "GetTargetRole — AI job search platform: real-time job discovery, Claude-powered resumes, tailored apply kits, recruiter outreach and application tracking.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @gettargetrole/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @gettargetrole/db db:generate",
    "db:migrate": "pnpm --filter @gettargetrole/db db:migrate",
    "db:seed": "pnpm --filter @gettargetrole/db db:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "prettier": "3.8.1",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}

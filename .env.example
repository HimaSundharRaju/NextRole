# ------------------------------------------------------------------
# NextRole configuration. Copy to `.env` (root) and apps/web/.env.local
# and fill in the blanks. Never commit real secrets.
# ------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Infrastructure (see infra/docker-compose.yml)
DATABASE_URL=postgres://nextrole:nextrole@localhost:5432/nextrole
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Optional: defaults to APP_URL
# BETTER_AUTH_URL=https://app.example.com
# Reverse proxies in front of the app (comma-separated IPs/CIDRs). Only needed when requests pass
# through more than one proxy hop (e.g. CDN -> load balancer), so rate limits see the client IP.
# TRUSTED_PROXIES=10.0.0.0/8

# 32 random bytes, base64 — generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Google sign-in (optional; set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# anthropic (default) | mock (tests only; refused in production)
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5

# Transactional email (verification, password reset). Unset in dev = logged to console.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="NextRole <no-reply@example.com>"

# Worker
INGEST_INTERVAL_MINUTES=10
INGEST_CONCURRENCY=4
WORKER_HEALTH_PORT=8081

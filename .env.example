# ------------------------------------------------------------------
# GetTargetRole configuration. Copy to `.env` (root) and apps/web/.env.local
# and fill in the blanks. Never commit real secrets.
# ------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Infrastructure (see infra/docker-compose.yml)
DATABASE_URL=postgres://nextrole:nextrole@localhost:5432/nextrole
REDIS_URL=redis://localhost:6379
# Only for databases whose certificate is signed by the provider's own CA (e.g. Supabase):
# the CA certificate's PEM text, so TLS is verified against it.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Auth — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Optional: defaults to APP_URL
# BETTER_AUTH_URL=https://app.example.com
# Reverse proxies in front of the app (comma-separated IPs/CIDRs). Only needed when requests pass
# through more than one proxy hop (e.g. CDN -> load balancer), so rate limits see the client IP.
# TRUSTED_PROXIES=10.0.0.0/8

# 32 random bytes, base64 — generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Google sign-in (optional; set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI model (Anthropic API) — https://console.anthropic.com
# The web app and the worker (for auto-prepare) both read these.
ANTHROPIC_API_KEY=
# anthropic (default) | mock (tests only; refused in production)
AI_PROVIDER=anthropic
# Each feature runs on the cheapest model that passed the quality check (packages/ai/src/routing.ts).
# Setting AI_MODEL puts every feature on that one Claude model instead; leave it unset for routing.
# AI_MODEL=claude-sonnet-5
# Override one feature: AI_ROUTE_<FEATURE>=openai:gpt-5-mini or anthropic:claude-sonnet-5
# (features: IMPORT, GENERATE, TAILOR, MATCH, COVER_LETTER, ANSWERS, OUTREACH, INTERVIEW, STUDIO).

# OpenAI (optional) — https://platform.openai.com/api-keys
# Features routed to OpenAI use it; without a key they fall back to Claude.
OPENAI_API_KEY=

# Auto-prepare sends its AI work through the batch API at half price. Applications are usually
# ready within minutes and always within 24 hours. AI_BATCH=off calls the AI right away instead.
# AI_BATCH=off

# Transactional email (verification, password reset). Unset in dev = logged to console.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="GetTargetRole <no-reply@example.com>"

# Worker
INGEST_INTERVAL_MINUTES=10
INGEST_CONCURRENCY=4
WORKER_HEALTH_PORT=8081
